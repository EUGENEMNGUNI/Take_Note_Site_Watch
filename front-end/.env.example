# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Local development with the Supabase CLI: run `supabase start` and copy the
# API URL and keys it prints. Hosted project: Project Settings -> API.

# Safe for the browser. Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import lib/supabase/admin.ts from a client component, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
