# Used only by the scripts in back-end/scripts. Copy to .env (git-ignored).

SUPABASE_URL=http://127.0.0.1:54321

# SERVICE ROLE key: bypasses Row Level Security. Server-side only, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Password given to every seeded test account (12+ characters). Choose your own;
# nothing is hard-coded in the repository.
SEED_PASSWORD=

# The seed script refuses to run against a non-local Supabase URL. Set this to
# "yes" only for a throwaway cloud project, never for real data.
# ALLOW_NON_LOCAL_SEED=yes
